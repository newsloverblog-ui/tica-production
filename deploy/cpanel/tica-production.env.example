# Merge these values into the production .env stored outside public_html.
# Replace every CHANGE_ME value in cPanel's environment/secret manager.
# Never commit the completed production file.

APP_NAME=Tica
APP_ENV=production
APP_DEBUG=false
APP_URL=https://CHANGE_ME
APP_KEY=CHANGE_ME_GENERATE_WITH_php_artisan_key_generate_show
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Shared, durable services suitable for a single-server cPanel deployment.
QUEUE_CONNECTION=database
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Generate each secret independently. Do not reuse APP_KEY.
TICKET_SIGNING_KEY=CHANGE_ME_32_BYTE_OR_LONGER_RANDOM_SECRET
TICKET_BUYER_IDENTITY_HASH_KEY=CHANGE_ME_DIFFERENT_32_BYTE_OR_LONGER_SECRET
TICKET_BUYER_IDENTITY_HASH_VERSION=1

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tickets@CHANGE_ME
MAIL_FROM_NAME=Tica

# Configure one real off-server incident destination.
OPS_INCIDENT_EMAIL=CHANGE_ME
OPS_INCIDENT_WEBHOOK_URL=
OPS_INCIDENT_WEBHOOK_SECRET=

# Keep these disabled until their real provider setup and drills pass.
TICKET_SMS_ENABLED=false
PAYOUT_AUTOMATIC_RELEASE_ENABLED=false
CSP_ENFORCE=false

# Generate once with a VAPID-capable tool and store as deployment secrets.
VAPID_SUBJECT=mailto:CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME

WEB_INSTALLER_ENABLED=false
WEB_UPDATER_ENABLED=false

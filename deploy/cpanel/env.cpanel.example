# TICA on cPanel: copy this to ".env" in the folder you uploaded, then fill in
# the lines marked FILL IN. Everything else can stay as it is.

APP_NAME=TICA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tica.ng                 # FILL IN: your domain, with https://
ASSET_URL=

# FILL IN: keep the APP_KEY from your current cPanel .env. Saved keys and
# secrets in the database are locked with it; a new key makes them unreadable.
APP_KEY=
# FILL IN: also keep these from the current .env (new install: 64 random characters each).
TICKET_SIGNING_KEY=
TICKET_BUYER_IDENTITY_HASH_KEY=
CRON_SECRET=

# cPanel → MySQL Databases: database name, user and password.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                            # FILL IN, e.g. socctsst_tica
DB_USERNAME=                            # FILL IN
DB_PASSWORD=                            # FILL IN

# Files on the server itself. Don't add LARAVEL_STORAGE_PATH on cPanel (it's for Vercel).
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
QUEUE_SYNC_ALLOWED=true
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=daily
LOG_LEVEL=warning
SUPPORT_TICKET_ATTACHMENT_DISK=local
SUPABASE_SUPPORT_ATTACHMENT_BUCKET=tica-private-support

# Email, SMS, Paystack, Google sign-in and the rest: set them in
# Admin → Integrations after the site is up (no need to put keys here).
MAIL_MAILER=log

WEB_INSTALLER_ENABLED=false
WEB_UPDATER_ENABLED=false
CSP_ENFORCE=true

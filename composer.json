{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "anandsiddharth/laravel-paytm-wallet": "^2.0",
    "anhskohbo/no-captcha": "^3.8",
    "barryvdh/laravel-dompdf": "^3.1",
    "baselrabia/myfatoorah-with-laravel": "^1.0",
    "guzzlehttp/guzzle": "^7.10",
    "ixudra/curl": "^6.22",
    "iyzico/iyzipay-php": "^2.0",
    "james-heinrich/getid3": "^1.9",
    "laravel-notification-channels/webpush": "^13.0.1",
    "laravel/framework": "^13.20",
    "laravel/socialite": "^5.31",
    "laravel/tinker": "^3.0",
    "maatwebsite/excel": "^4.0.6",
    "mews/purifier": "^3.4.4",
    "midtrans/midtrans-php": "^2.5",
    "mollie/laravel-mollie": "^5.0",
    "phpmailer/phpmailer": "^7.0",
    "razorpay/razorpay": "^2.9",
    "simplesoftwareio/simple-qrcode": "~4",
    "spatie/laravel-cookie-consent": "^3.5",
    "stripe/stripe-php": "^22.1"
  },
  "require-dev": {
    "spatie/laravel-ignition": "^2.12",
    "fakerphp/faker": "^1.24",
    "laravel/sail": "^1.69",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^13.1.14"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Http/Helpers/Helper.php",
      "app/Http/Helpers/UploadFile.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "vercel": [
      "@php artisan package:discover --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "baselrabia/myfatoorah-with-laravel"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
